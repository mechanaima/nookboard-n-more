# Copy to `.env` (gitignored) and fill in. A real environment variable always
# wins over this file, so `SIEVE_API_KEY=... make dev` also works.

# sieve scrape API key. Full account access and no scopes: server-side only,
# never in a browser, log, or commit.
# Get one with `./tools/sieve-login.py` (device login, user approves in a
# browser) or from Settings -> API keys.
SIEVE_API_KEY=

# Optional: override the API base (default https://scrape.usesieve.com).
# NOOKBOARD_SIEVE_BASE_URL=https://scrape.usesieve.com
